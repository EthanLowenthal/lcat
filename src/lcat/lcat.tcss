Screen {
    background: $surface;
}

#view {
    height: 1fr;
}

/* --- table view --- */

DataTable {
    height: 1fr;
}

/* --- a coloured worksheet is drawn on its own sheet of paper ---
   An xlsx picks its colours assuming a white page behind them. Rendering one over a
   dark terminal theme would make the file's own defaults (black text, no fill)
   invisible, so a sheet that carries colours gets the page too. Sheets with no
   colours of their own keep the app's theme -- see WorkbookView._add_columns. */

WorkbookView.styled DataTable {
    background: #ffffff;
    color: #1a1a1a;
    /* DataTable tints its own background with $foreground 5% while focused, which
       turns the paper grey. */
    background-tint: transparent;
    scrollbar-background: #ffffff;
    scrollbar-color: #b8b8b8;
    scrollbar-background-hover: #ffffff;
    scrollbar-background-active: #ffffff;
}

WorkbookView.styled DataTable > .datatable--header {
    background: #e8e8e8;
    color: #1a1a1a;
    background-tint: transparent;
    text-style: bold;
}

/* fixed_columns=1 paints column 0 with a theme colour of its own. */
WorkbookView.styled DataTable > .datatable--fixed {
    background: #f2f2f2;
    color: #1a1a1a;
}

WorkbookView.styled DataTable > .datatable--cursor,
WorkbookView.styled DataTable > .datatable--fixed-cursor,
WorkbookView.styled DataTable > .datatable--header-cursor {
    background: #1a56b8;
    color: #ffffff;
    text-style: bold;
}

WorkbookView.styled DataTable > .datatable--hover {
    background: #dbe7ff;
}

#sheets {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#search {
    dock: bottom;
    border: none;
    height: 1;
    padding: 0 1;
    background: $boost;
}

/* --- raw text editor (i) --- */

#editor {
    height: 1fr;
    border: none;
    padding: 0 1;
}

#cell-editor {
    height: auto;
    min-height: 3;
    max-height: 16;
    border: none;
    padding: 0;
    background: $boost;
}

/* --- code view --- */

CodeView {
    padding: 0 1;
}

/* --- image view --- */

ImageView {
    align: center middle;
}

.markdown-image {
    width: auto;
    height: auto;
}

/* --- modals --- */

CellModal, HelpModal, QuitModal {
    align: center middle;
    background: $background 60%;
}

#cell-dialog, #help-dialog, #quit-dialog {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $primary;
}

#cell-title, #help-title, #quit-title {
    height: auto;
    padding-bottom: 1;
}

#cell-body, #help-body {
    height: auto;
    max-height: 20;
}

#cell-hint {
    /* border-box: the padding has to be inside the height, or the line is clipped */
    height: 2;
    padding-top: 1;
    color: $text-muted;
}

#quit-dialog {
    max-width: 44;
    border: round $warning;
}

#quit-body {
    height: auto;
}

/* --- PDF view: the text reading of a page --- */

#page-text {
    padding: 1 2;
}
