Screen {
    background: $surface;
}

#view {
    height: 1fr;
}

/* --- table view --- */

DataTable {
    height: 1fr;
}

#status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#search {
    dock: bottom;
    border: none;
    height: 1;
    padding: 0 1;
    background: $boost;
}

/* --- raw text editor (i) --- */

#editor {
    height: 1fr;
    border: none;
    padding: 0 1;
}

#cell-editor {
    height: auto;
    min-height: 3;
    max-height: 16;
    border: none;
    padding: 0;
    background: $boost;
}

/* --- code view --- */

CodeView {
    padding: 0 1;
}

/* --- image view --- */

ImageView {
    align: center middle;
}

.markdown-image {
    width: auto;
    height: auto;
}

/* --- modals --- */

CellModal, HelpModal, QuitModal {
    align: center middle;
    background: $background 60%;
}

#cell-dialog, #help-dialog, #quit-dialog {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $primary;
}

#cell-title, #help-title, #quit-title {
    height: auto;
    padding-bottom: 1;
}

#cell-body, #help-body {
    height: auto;
    max-height: 20;
}

#cell-hint {
    /* border-box: the padding has to be inside the height, or the line is clipped */
    height: 2;
    padding-top: 1;
    color: $text-muted;
}

#quit-dialog {
    max-width: 44;
    border: round $warning;
}

#quit-body {
    height: auto;
}
